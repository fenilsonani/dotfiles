  "auto_install_extensions": {
    "seti-icons": true
  },
  "icon_theme": "Seti Icon Theme",

  // --- Discoverability ------------------------------------------------
  // Status-bar buttons are the entry point to every panel. With them off,
  // the only way in is the command palette.
  "project_panel": {
    "button": true,
    "dock": "left",
    "file_icons": true,
    "folder_indicator": "chevron",
    "git_status": true,
    "entry_spacing": "standard",
    "default_width": 260,
    "indent_size": 8,
    "starts_open": true,
    "bold_folder_labels": false,
    "indent_guides": {
      "show": "always"
    }
  },
  "outline_panel": {
    "button": true,
    "dock": "left",
    "default_width": 260,
    "file_icons": true,
    "folder_indicator": "chevron",
    "indent_size": 8
  },
  "git_panel": {
    "button": true,
    "dock": "left",
    "default_width": 260,
    "file_icons": true,
    "folder_indicator": "chevron",
    "status_style": "label_color"
  },
  "terminal": {
    "button": true,
    "dock": "bottom",
    "font_family": "Menlo",
    "font_size": 12,
    "line_height": {
      "custom": 1.5
    },
    "default_height": 280
  },

  // Breadcrumbs, quick actions and the code-action (lightbulb) button are
  // the visible affordances VS Code trains you to reach for.
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": false,
    "code_actions": true,
    "agent_review": false
  },

  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": true
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_close_button": "hover",
    "close_position": "right"
  },

  "title_bar": {
    "show_branch_name": false,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false
  },
  "status_bar": {
    "line_endings_button": true,
    "active_encoding_button": "enabled"
  },
  "rounded_selection": false,

  "bottom_dock_layout": "contained",

  "show_wrap_guides": false,

  "sticky_scroll": {
    "enabled": true
  },

  // --- Visual structure -----------------------------------------------
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0
  },
  "current_line_highlight": "all",
  "indent_guides": {
    "enabled": true,
    "coloring": "fixed"
  },
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    "diagnostics": "all",
    "cursors": true
  },
  "minimap": {
    "show": "always"
  },
  "unnecessary_code_fade": 0.4,
  "show_whitespaces": "selection",

  // --- Behaviour ------------------------------------------------------
  "use_smartcase_search": true,
  "autosave": "on_focus_change",
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "disable_ai": true,

  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },

  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },

  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false
    }
  }
}
