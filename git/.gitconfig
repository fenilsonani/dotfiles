[user]
	name = Fenil Sonani
	email = 107786545+fenilsonani@users.noreply.github.com
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[commit]
	gpgsign = false
[coderabbit]
	machineId = cli/7d7cb18ac51a4958b6125b168f180441
[gitbutler]
	aiModelProvider = anthropic
	diffLengthLimit = 50000
[core]
	excludesfile = /Users/fenilsonani/.gitignore_global
	pager = delta
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[alias]
	# prune stale worktrees, drop remote-tracking refs, delete branches already merged into origin/main
	wtclean = !git worktree prune -v && git fetch -p && git branch --merged origin/main | grep -vE '^\\*|(^|\\s)(main|master)$' | xargs -r git branch -d
[credential "https://sailfork.com"]
	helper = !/Users/fenilsonani/.local/bin/sf auth git-credential
	useHttpPath = false
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
